        "jsCode": "const input = $input.first().json;\n\nconst edges =\n  input?.data?.events?.edges ??\n  input?.[0]?.data?.events?.edges ?? \n  [];\n\nconst rows = edges.map(e => ({\n  id: e?.node?.id ?? '',\n  legacyId: e?.node?.legacyId ?? '',\n  title: e?.node?.title ?? '',\n}));\n\nfunction esc(s) {\n  return String(s)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nconst tableRowsHtml = rows.map(r => `\n  <tr>\n    <td><code>${esc(r.legacyId)}</code></td>\n    <td>${esc(r.title)}</td>\n    <td><code>${esc(r.id)}</code></td>\n  </tr>\n`).join('');\n\nconst html = `<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Administrate Events</title>\n  <style>\n    :root { color-scheme: light dark; }\n    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 24px; }\n    .wrap { max-width: 1100px; margin: 0 auto; }\n    h1 { margin: 0 0 8px; font-size: 22px; }\n    .meta { opacity: 0.8; margin-bottom: 16px; }\n    .bar { display:flex; gap: 12px; align-items:center; margin: 16px 0; }\n    input[type=\"search\"] { flex:1; padding: 10px 12px; font-size: 14px; border: 1px solid rgba(127,127,127,.35); border-radius: 10px; }\n    .pill { padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(127,127,127,.35); font-size: 12px; }\n    table { width: 100%; border-collapse: collapse; border: 1px solid rgba(127,127,127,.35); border-radius: 14px; overflow: hidden; }\n    thead th { text-align: left; font-size: 12px; letter-spacing: .02em; text-transform: uppercase; padding: 12px; background: rgba(127,127,127,.12); }\n    tbody td { padding: 12px; border-top: 1px solid rgba(127,127,127,.25); vertical-align: top; }\n    tbody tr:hover { background: rgba(127,127,127,.08); }\n    code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace; font-size: 12px; }\n    .muted { opacity: .75; font-size: 12px; }\n    .empty { padding: 24px; border: 1px dashed rgba(127,127,127,.35); border-radius: 14px; }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <h1>Administrate Events</h1>\n    <div class=\"meta muted\">Rendered from GraphQL response</div>\n\n    <div class=\"bar\">\n      <input id=\"q\" type=\"search\" placeholder=\"Search by title, legacy ID, or GraphQL ID…\" />\n      <div class=\"pill\"><span id=\"count\">${rows.length}</span> events</div>\n    </div>\n\n    ${rows.length ? `\n    <table>\n      <thead>\n        <tr>\n          <th style=\"width: 120px;\">Legacy ID</th>\n          <th>Title</th>\n          <th style=\"width: 420px;\">GraphQL ID</th>\n        </tr>\n      </thead>\n      <tbody id=\"tbody\">\n        ${tableRowsHtml}\n      </tbody>\n    </table>\n    ` : `<div class=\"empty\">No events found in the response.</div>`}\n\n    <p class=\"muted\" style=\"margin-top:16px;\">\n      Tip: use the search box to filter instantly.\n    </p>\n  </div>\n\n  <script>\n    const q = document.getElementById('q');\n    const tbody = document.getElementById('tbody');\n    const count = document.getElementById('count');\n\n    if (q && tbody && count) {\n      const rows = Array.from(tbody.querySelectorAll('tr'));\n\n      q.addEventListener('input', () => {\n        const term = q.value.toLowerCase().trim();\n        let shown = 0;\n\n        for (const tr of rows) {\n          const txt = tr.textContent.toLowerCase();\n          const ok = !term || txt.includes(term);\n          tr.style.display = ok ? '' : 'none';\n          if (ok) shown++;\n        }\n        count.textContent = shown;\n      });\n    }\n  </script>\n</body>\n</html>`;\n\nreturn [\n  {\n    json: {\n      html,\n    },\n  },\n];\n"
      },
