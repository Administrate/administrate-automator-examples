        "jsCode": "function randState(len = 32) {\n  const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n  let out = '';\n  for (let i = 0; i < len; i++) out += chars[Math.floor(Math.random() * chars.length)];\n  return out;\n}\n\nfunction base64urlEncode(str) {\n  return Buffer.from(str, 'utf8')\n    .toString('base64')\n    .replace(/\\+/g, '-')\n    .replace(/\\//g, '_')\n    .replace(/=+$/, '');\n}\n\nconst csrf = randState(48);\n\nconst workflowOrigin = $('OAuth Start').first().json.query[\"workflow-origin\"];\nconst instance = $input.first().json.instance;\nconst redirectUri = \"https://\" + $('OAuth Start').first().json.headers.host + \"/webhook/oauth/callback\";\nconst clientId = $input.first().json.client_id;\n\nconst statePayload = {\n  csrf,\n  workflowOrigin\n};\n\nconst state = base64urlEncode(JSON.stringify(statePayload));\n\n// This returns a URL encoded query string replaces URLSearchParams, which is not available in n8n but would have been simpler.\nfunction qs(obj) {\n  return Object.entries(obj)\n    .filter(([_, v]) => v !== undefined && v !== null && v !== '')\n    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)\n    .join('&');\n}\n\nconst params = qs({\n  response_type: 'code',\n  client_id: clientId,\n  redirect_uri: redirectUri,\n  state,\n  instance\n});\n\nconst authorizeUrl = `https://auth.getadministrate.com/oauth/authorize?${params}`;\n\nreturn [{ state, instance, redirectUri, authorizeUrl, workflowOrigin }];\n"
      },
