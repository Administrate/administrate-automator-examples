        "jsCode": "function isAllowedRedirect(urlString) {\n  if (!urlString || typeof urlString !== 'string') return false;\n\n  const trimmed = urlString.trim();\n  // Require:\n  // - https\n  // - exact host n8n.administratehq.com\n  // - optional :443\n  // - any path or query\n  const match = trimmed.match(\n    /^https:\\/\\/n8n\\.administratehq\\.com(?::(\\d+))?(\\/|$)/i\n  );\n\n  if (!match) return false;\n\n  const port = match[1];\n  if (port && port !== '443') return false;\n\n  return true;\n}\n\nconst workflowOrigin = String($input.first().json.workflowOrigin || '').trim();\nconst validURL = isAllowedRedirect(workflowOrigin);\n\nreturn [\n  {\n    json: {\n      workflowOrigin,\n      validURL\n    }\n  }\n];\n"
