    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n\n  const now = new Date();\n  const twentyFourHoursAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n  \n  // Format to YYYY-MM-DDTHH:mm:ss in UTC\n  const formatted = twentyFourHoursAgo.toISOString().split('.')[0];\n\n  item.json.yesterday = formatted;\n\n}\n\nreturn $input.all();"
      },
