        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "=query externalLogOrigins {\n  externalLogOrigins (filters:{field:name operation:contains values:[\"{{ $('Config').first().json.LOG_ORIGIN_NAME }}\"]}) {\n  \tedges\t{\n      node {\n        name\n        id\n      }\n    }\n  }\n}"
