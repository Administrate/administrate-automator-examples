        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "=query externalLogs ($cursor: String) {\n  externalLogs (after: $cursor, filters:[{field:externalLogOriginId operation:eq value:\"{{ $('Define Last 24 Hours').item.json.data.externalLogOrigins.edges[0].node.id }}\"}, {field:createdAt operation:gt value:\"{{ $('Define Last 24 Hours').item.json.yesterday }}\"}] order:{field:createdAt direction:asc}) {\n    edges {\n      node {\n        id\n        externalLogOrigin {\n          id\n          name\n        }\n        status\n        entityId\n        createdAt\n        message\n        payload\n      }\n    }\n    pageInfo {\n      hasNextPage\n      endCursor\n    }\n  }\n}"
            }
