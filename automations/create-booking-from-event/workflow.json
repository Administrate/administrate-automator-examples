    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const node = item.json.body.payload.node;\n\n  // Decode Base64 IDs\n  const decodedCurrencyId = Buffer.from(node.defaultPrice.financialUnit.id, 'base64').toString('utf8');\n\n  // Optionally, extract just the values after colon\n  const currencyValue = decodedCurrencyId.split(':')[1];\n\n  // Save decoded values in JSON\n  item.json.decoded = {\n    currency: currencyValue     // GBP\n  };\n\n  return item;\n});"
      },
