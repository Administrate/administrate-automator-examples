        }
      }
    },
    {
      "parameters": {
        "jsCode": "const result = $json.data.contact.awardAchievement;\nconst courseCode = $('Parse Selections').item.json.courseCode;\nif (result.errors && result.errors.length > 0) {\n  return [{ json: { statusMessage: `✗ ${$('Parse Selections').item.json.contactId}: ${result.errors[0].message}`, success: false, courseCode } }];\n}\nreturn [{ json: { statusMessage: `✓ ${result.contact.firstName} ${result.contact.lastName}`, success: true, courseCode } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
