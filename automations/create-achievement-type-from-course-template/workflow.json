    {
      "parameters": {
        "jsCode": "const escapeHtml = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&#39;');\n\nconst items = $input.all();\nconst courseCode = items[0]?.json.courseCode || '';\nconst rows = items.map(i => `<li class=\"${i.json.success ? 'ok' : 'err'}\">${escapeHtml(i.json.statusMessage)}</li>`).join('');\nconst html = `<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Done</title>\n<style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;max-width:520px;margin:48px auto;padding:0 24px;color:#111}h1{font-size:1.3em}\nul{list-style:none;padding:0;border:1px solid #e0e0e0;border-radius:6px;overflow:hidden}\nli{padding:12px 16px;border-bottom:1px solid #f0f0f0}li:last-child{border-bottom:none}\nli.ok{color:#1a7a1a}li.err{color:#cc0000}\n.done{background:#f0f7ff;border:1px solid #b3d4f5;border-radius:6px;padding:12px 16px;margin-top:20px;font-size:.9em;color:#0055aa}\n</style></head><body>\n<h1>Achievement Awards Complete</h1>\n<p>Results for <strong>${escapeHtml(courseCode)}</strong>:</p>\n<ul>${rows||'<li>No instructors were processed.</li>'}</ul>\n<div class=\"done\">You can close this window.</div>\n</body></html>`;\nreturn [{ json: { html } }];"
      },
