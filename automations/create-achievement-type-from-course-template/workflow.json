    {
      "parameters": {
        "jsCode": "const body = $('Form Submission').first().json.body;\nlet ids = body.instructorId;\nif (!ids) return [{ json: { noSelection: true, achievementTypeId: body.achievementTypeId, courseCode: body.courseCode } }];\nif (!Array.isArray(ids)) ids = [ids];\nconst year = new Date().getFullYear();\nconst today = new Date().toISOString().split('T')[0];\nreturn ids.map(contactId => ({\n  json: {\n    contactId,\n    achievementTypeId: body.achievementTypeId,\n    courseCode: body.courseCode,\n    validFrom: today\n  }\n}));"
      },
