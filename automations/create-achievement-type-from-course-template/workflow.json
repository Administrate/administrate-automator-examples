        "jsonBody": "={{ JSON.stringify({ query: \"mutation AwardAchievement($input: ContactAwardAchievementInput!) { contact { awardAchievement(input: $input) { contact { id firstName lastName } errors { label message value } } } }\", variables: { input: { contactId: $json.contactId, achievementTypeId: $json.achievementTypeId, validFrom: $json.validFrom } } }) }}",
